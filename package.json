{
  "name": "phased-shutdown",
  "version": "9.0.2",
  "description": "Graceful shutdown for Node.js with ordered async cleanup phases.",
  "type": "module",
  "exports": {
    "types": "./index.d.ts",
    "default": "./index.js"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "tsc -p tsconfig.types-test.json && node --test --test-reporter=spec tests/index.test.js tests/subprocess.test.js tests/signals.test.js",
    "coverage": "c8 node --test --test-reporter=spec tests/index.test.js tests/subprocess.test.js tests/signals.test.js tests/release.test.js tests/workflows.test.js tests/ci-validation.test.js",
    "test:package": "node scripts/test-package.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint . && tsc -p tsconfig.types-test.json && npm run coverage && node scripts/test-package.js",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msanguineti/phased-shutdown.git"
  },
  "keywords": [
    "graceful-shutdown",
    "phased-shutdown",
    "nodejs",
    "shutdown",
    "cleanup",
    "async-cleanup",
    "signal-handlers",
    "sigterm",
    "sigint",
    "sighup",
    "beforeexit",
    "process-lifecycle",
    "typescript",
    "esm"
  ],
  "author": "Mirco Sanguineti",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/msanguineti/phased-shutdown/issues"
  },
  "homepage": "https://msanguineti.github.io/phased-shutdown",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
