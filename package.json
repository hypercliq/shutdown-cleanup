{
  "name": "@hypercliq/shutdown-cleanup",
  "version": "9.0.0",
  "description": "Phased graceful shutdown for Node.js — signal handlers, async cleanup, configurable error strategy",
  "type": "module",
  "exports": {
    "types": "./index.d.ts",
    "default": "./index.js"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "tsc -p tsconfig.types-test.json && node --test --test-reporter=spec tests/index.test.js tests/subprocess.test.js tests/signals.test.js",
    "coverage": "c8 node --test --test-reporter=spec tests/index.test.js tests/subprocess.test.js tests/signals.test.js tests/release.test.js tests/workflows.test.js",
    "test:package": "node scripts/test-package.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint . && tsc -p tsconfig.types-test.json && npm run coverage && node scripts/test-package.js",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypercliq/shutdown-cleanup.git"
  },
  "keywords": [
    "graceful-shutdown",
    "graceful",
    "shutdown",
    "cleanup",
    "signal",
    "sigterm",
    "sigint",
    "sighup",
    "process",
    "exit",
    "handler",
    "hooks",
    "lifecycle",
    "phased-shutdown",
    "async",
    "typescript",
    "esm",
    "nodejs"
  ],
  "author": "Hypercliq",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hypercliq/shutdown-cleanup/issues"
  },
  "homepage": "https://hypercliq.github.io/shutdown-cleanup",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
